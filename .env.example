# Optional. Without this key the simulator uses mock Gemini output.
GEMINI_API_KEY=

# Optional overrides. Production already ships the speedy-equator-122704
# web client config, so Google sign-in works without these. Set them only
# when pointing a fork at a different Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
