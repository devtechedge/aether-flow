# Optional. Without this key the simulator uses mock Gemini output.
GEMINI_API_KEY=

# Required for Google sign-in when running locally. Production already ships
# the speedy-equator-122704 web client config through Vercel, so these are only
# needed to point a fork at a different Firebase project.
# The API key must never be committed. Copy it from the Vercel project or the
# Firebase console.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
